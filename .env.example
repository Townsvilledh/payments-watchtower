# Payments Watchtower runs keyless by default: agents reason through a local,
# deterministic Mozaik endpoint (see src/local-model.ts), so judges can run the
# demo with no accounts and no API keys.
#
# Optional: to run the same agents against a hosted model instead, set one of
# the keys below and set MODEL in src/config.ts to a matching supported model.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
